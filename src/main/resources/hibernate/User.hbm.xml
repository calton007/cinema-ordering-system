<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.file">
    <class name="User" table="user">
        <id name="id" column="id" type="java.lang.Integer">
            <generator class="native"/>
        </id>
        <property name="u_name" column="u_name" type="java.lang.String"/>
        <property name="c_name" column="c_name" type="java.lang.String"/>
        <property name="password" column="password" type="java.lang.String"/>
        <property name="remainder" column="remainder" type="java.lang.Double"/>
        <property name="tel" column="tel" type="java.lang.String"/>
        <property name="email" column="email" type="java.lang.String"/>
        <property name="type" column="type" type="java.lang.Integer"/>
    </class>
</hibernate-mapping>
